# Node/TypeScript execution image. Build on the target host for its native CPU architecture.
FROM node:22-bookworm-slim
ARG CODEX_VERSION=0.160.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends git bash ca-certificates python3 build-essential procps ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @openai/codex@${CODEX_VERSION} \
    && npm cache clean --force \
    && mkdir -p /workspace /codex \
    && chown node:node /workspace /codex
ENV HOME=/codex CODEX_HOME=/codex
USER node
WORKDIR /workspace
CMD ["sleep", "infinity"]
