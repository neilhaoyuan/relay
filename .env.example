# Copy to .env. Start Relay using npm start so this file is loaded.
RELAY_HOST=127.0.0.1
RELAY_PORT=8080
RELAY_DATA_DIR=.relay-data
RELAY_IMAGE=relay-workspace:0.1.0
RELAY_MAX_AGENTS=2
RELAY_MAX_ENVIRONMENTS=3
RELAY_CPUS=0.5
RELAY_MEMORY_MB=2048
RELAY_RUN_TIMEOUT_MINUTES=60
# Set to your exact HTTPS Tailscale Serve origin, without a trailing slash.
# RELAY_PUBLIC_ORIGIN=https://your-vm.your-tailnet.ts.net
# Optional; otherwise generated in RELAY_DATA_DIR/access-token. At least 24 characters.
# RELAY_ACCESS_TOKEN=
